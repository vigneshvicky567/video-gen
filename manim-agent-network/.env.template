# ─── Required ────────────────────────────────────────────────────────────────
# NVIDIA NIM API key — used for all LLM calls (DeepSeek-R1 via NVIDIA NIM)
# Obtain from https://integrate.api.nvidia.com
NVIDIA_API_KEY=your-nvidia-api-key-here

# ─── LLM Model Configuration (NVIDIA NIM) ────────────────────────────────────
# All LLM calls route through https://integrate.api.nvidia.com/v1
SCRIPT_WRITER_MODEL=moonshotai/kimi-k2-instruct
CODE_GENERATOR_MODEL=moonshotai/kimi-k2-instruct
COMPOSITOR_LLM_MODEL=moonshotai/kimi-k2-instruct

# ─── Pexels API (for fetching context images) ────────────────────────────────
# Obtain from https://www.pexels.com/api/
PEXELS_API_KEY=

# ─── Voiceover Provider ───────────────────────────────────────────────────────
# Accepted values: dia2 | kokoro
VOICEOVER_PROVIDER=dia2
VOICEOVER_FALLBACK_PROVIDER=kokoro
ALLOW_ESPEAK_FALLBACK=false

# ─── Dia2 TTS (only used when VOICEOVER_PROVIDER=dia2) ───────────────────────
# Dia2 is a streaming dialogue TTS model by Nari Labs.
# Weights are auto-downloaded from HF on first use — no manual download needed.
# Repo: https://github.com/nari-labs/dia2
#
# Model options:
#   nari-labs/Dia2-1B  (~4GB VRAM, faster)
#   nari-labs/Dia2-2B  (~6GB VRAM, higher quality)
#
# To enable: set VOICEOVER_PROVIDER=dia2 and start with the dia2 profile:
#   docker compose --profile dia2 up
DIA2_MODEL=nari-labs/Dia2-1B
DIA2_DEVICE=cuda
DIA2_DTYPE=bfloat16
DIA2_CFG_SCALE=2.0
DIA2_TEMPERATURE=0.8

# ─── Kokoro ONNX fallback (offline, CPU-capable) ─────────────────────────────
KOKORO_MODEL_PATH=/models/kokoro/kokoro-v1.0.int8.onnx
KOKORO_VOICES_PATH=/models/kokoro/voices-v1.0.bin
KOKORO_VOICE=af_sarah
KOKORO_SPEED=1.0
KOKORO_LANG=en-us

# ─── LangSmith Tracing (optional) ────────────────────────────────────────────
# Obtain from https://langsmith.com
# Leave as placeholder or empty to disable tracing (no error will be raised)
LANGSMITH_API_KEY=your-langsmith-api-key-here
