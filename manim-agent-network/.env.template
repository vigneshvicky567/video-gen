# ─── Required ────────────────────────────────────────────────────────────────
# NVIDIA NIM API key — used for all LLM calls
# Obtain from https://integrate.api.nvidia.com
NVIDIA_API_KEY=your-nvidia-api-key-here

# ─── Anthropic Claude (optional) ─────────────────────────────────────────────
# The shared client routes any claude-* model id to Anthropic automatically —
# point a slot below at claude-opus-4-8 / claude-sonnet-4-6 to use it.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_RPM=50
ANTHROPIC_MAX_CONCURRENT=5

# ─── LLM Model Configuration ─────────────────────────────────────────────────
# Defaults match shared/config.py (NIM models — run with just NVIDIA_API_KEY).
# Claude alternates: SCRIPT_WRITER_MODEL=claude-opus-4-8, CHAT_MODEL=claude-sonnet-4-6
# NOTE: verify the id is actually served for YOUR account (GET /v1/models) —
# NIM retires functions silently and a dead id 404s every job (observed with
# moonshotai/kimi-k2.6 on 2026-07-13).
SCRIPT_WRITER_MODEL=mistralai/mistral-large-3-675b-instruct-2512
# Comma-separated ordered fallbacks tried when SCRIPT_WRITER_MODEL fails.
# Ping-verified 2026-07-13. Avoid reasoning-only models (e.g. nemotron-super
# v1.5) — they return empty content and fail the script parser.
SCRIPT_WRITER_FALLBACK_MODELS=openai/gpt-oss-120b,deepseek-ai/deepseek-v4-flash
CODE_GENERATOR_MODEL=qwen/qwen3-coder-480b-a35b-instruct
COMPOSITOR_LLM_MODEL=moonshotai/kimi-k2-instruct
CHAT_MODEL=mistralai/mistral-small-4-119b-2603

# ─── Image sources (per-term searched, then SigLIP + vision-LLM ranked) ───────
# Pexels: https://www.pexels.com/api/   Pixabay: https://pixabay.com/api/docs/
# Both optional; with neither set the fetcher falls back to Wikimedia (lower quality).
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Vision-capable model for the final image relevance vet (must SEE images).
# Empty -> vision stage skipped, SigLIP ranking used as-is.
IMAGE_EVAL_MODEL=meta/llama-3.2-90b-vision-instruct
# SigLIP relevance scorer (ONNX). Models downloaded during Docker build.
SIGLIP_MODEL_DIR=/models/siglip
SIGLIP_THRESHOLD=0.15

# ─── Voiceover Provider ───────────────────────────────────────────────────────
VOICEOVER_PROVIDER=kokoro
# Free fallback when Kokoro fails (no API key, needs network). Set empty to disable.
VOICEOVER_FALLBACK_PROVIDER=edge_tts
EDGE_TTS_VOICE=en-US-JennyNeural
VOICEOVER_MAX_RETRIES=3
VOICEOVER_RETRY_BACKOFF_SECONDS=2.0

# ─── Kokoro ONNX TTS (CPU-capable, offline) ──────────────────────────────────
KOKORO_MODEL_PATH=/models/kokoro/kokoro-v1.0.int8.onnx
KOKORO_VOICES_PATH=/models/kokoro/voices-v1.0.bin
KOKORO_VOICE=af_sarah
KOKORO_SPEED=1.0
KOKORO_LANG=en-us

# ─── Final-cut polish: background music + intro/outro branding ───────────────
# Drop assets in ./assets/ and set paths here. All three are optional — empty = off.
# Compositor mounts ./assets:/assets:ro so use /assets/... paths inside Docker.
# Example: INTRO_VIDEO_PATH=/assets/intro.mp4
INTRO_VIDEO_PATH=
OUTRO_VIDEO_PATH=
BG_MUSIC_PATH=
BG_MUSIC_VOLUME=0.12
BG_MUSIC_FADEOUT_SECONDS=2.0

# ─── LangSmith Tracing (optional) ────────────────────────────────────────────
LANGSMITH_API_KEY=your-langsmith-api-key-here
