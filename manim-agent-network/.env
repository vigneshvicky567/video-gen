# NVIDIA NIM API for all LLM calls
NVIDIA_API_KEY=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

# Anthropic Claude API (commented out — Claude API expired, reverted to NVIDIA)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# LLM Model Configuration (NVIDIA NIM)
SCRIPT_WRITER_MODEL=moonshotai/kimi-k2-instruct
CODE_GENERATOR_MODEL=qwen/qwen3-coder-480b-a35b-instruct
COMPOSITOR_LLM_MODEL=moonshotai/kimi-k2-instruct

# Voiceover Provider: Kokoro ONNX (CPU-capable, offline)
VOICEOVER_PROVIDER=kokoro
VOICEOVER_FALLBACK_PROVIDER=espeak
ALLOW_ESPEAK_FALLBACK=true

# Kokoro ONNX TTS Settings
KOKORO_MODEL_PATH=/models/kokoro/kokoro-v1.0.int8.onnx
KOKORO_VOICES_PATH=/models/kokoro/voices-v1.0.bin
KOKORO_VOICE=af_bella
KOKORO_SPEED=0.9
KOKORO_LANG=en-us

# LangSmith Tracing (optional)
LANGSMITH_API_KEY=your-langsmith-api-key
