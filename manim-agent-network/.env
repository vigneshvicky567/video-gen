# NVIDIA NIM API for all LLM calls
NVIDIA_API_KEY=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

# LLM Model Configuration (NVIDIA NIM)
SCRIPT_WRITER_MODEL=moonshotai/kimi-k2-instruct
CODE_GENERATOR_MODEL=moonshotai/kimi-k2-instruct
COMPOSITOR_LLM_MODEL=moonshotai/kimi-k2-instruct

# Voiceover Provider: dia2 first, Kokoro ONNX fallback
VOICEOVER_PROVIDER=dia2
VOICEOVER_FALLBACK_PROVIDER=kokoro
ALLOW_ESPEAK_FALLBACK=false

# Dia2 TTS Settings (only when VOICEOVER_PROVIDER=dia2)
DIA2_MODEL=nari-labs/Dia2-1B
DIA2_DEVICE=cuda
DIA2_DTYPE=bfloat16
DIA2_CFG_SCALE=2.0
DIA2_TEMPERATURE=0.8

# Kokoro ONNX offline fallback
KOKORO_MODEL_PATH=/models/kokoro/kokoro-v1.0.int8.onnx
KOKORO_VOICES_PATH=/models/kokoro/voices-v1.0.bin
KOKORO_VOICE=af_sarah
KOKORO_SPEED=1.0
KOKORO_LANG=en-us

# LangSmith Tracing (optional)
# Get your API key from https://langsmith.com
LANGSMITH_API_KEY=your-langsmith-api-key
