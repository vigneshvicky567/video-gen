# Stage 1: install hyperframes via Node 22 (required by hyperframes)
FROM node:22-slim AS node_stage

# Pinned: render output + composition contract are version-sensitive (`@latest`
# can silently change the runtime/CLI flags and break renders). Verified working.
RUN npm install -g --prefix /usr/local hyperframes@0.6.97

# Stage 2: final image based on the shared base
FROM base-manim-agent

# Copy Node runtime and npx/hyperframes from node stage
COPY --from=node_stage /usr/local/bin/node /usr/local/bin/node
COPY --from=node_stage /usr/local/bin/npx  /usr/local/bin/npx
COPY --from=node_stage /usr/local/lib/node_modules /usr/local/lib/node_modules

# Set NODE_PATH so node can find globally installed modules
ENV NODE_PATH=/usr/local/lib/node_modules

# Create symlink so `hyperframes` is directly callable as well
RUN ln -sf /usr/local/lib/node_modules/hyperframes/bin/hyperframes.js /usr/local/bin/hyperframes 2>/dev/null || true

# Install Chromium for HyperFrames rendering
# HyperFrames needs a headless browser to render HTML to video frames
RUN apt-get update && \
    apt-get install -y \
    chromium \
    chromium-driver \
    && rm -rf /var/lib/apt/lists/*

# Set environment variable to tell Puppeteer/HyperFrames where to find Chromium
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV CHROME_BIN=/usr/bin/chromium

# ffmpeg/ffprobe are already present in base-manim-agent; ensure they are available
RUN ffprobe -version > /dev/null 2>&1 || (apt-get update && apt-get install -y ffmpeg && rm -rf /var/lib/apt/lists/*)

COPY shared/ /app/shared/
COPY services/compositor/ /app/

EXPOSE 8005

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8005"]
